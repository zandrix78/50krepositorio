app.post('/api/pedidos', (req, res) => {
  const db = readDb();
  const newPedido = {
    id: `#${1000 + db.pedidos.length}`,
    cliente: req.body.cliente || 'Cliente novo',
    canal: req.body.canal || 'Delivery',
    status: req.body.status || 'Em preparo',
    pagamento: req.body.pagamento || 'Pix',
    valor: req.body.valor || 0,
  };

  db.pedidos.unshift(newPedido);
  writeDb(db);
  res.status(201).json(newPedido);
});

app.post('/api/produtos', (req, res) => {
  const db = readDb();
  const novoProduto = {
    id: Date.now(),
    nome: req.body.nome || 'Novo produto',
    quantidade: req.body.quantidade || 0,
    valor: req.body.valor || 0,
    categoria: req.body.categoria || 'Geral',
  };

  db.cardapio.push(novoProduto);
  writeDb(db);
  res.status(201).json(novoProduto);
});

app.get('/api/health', (req, res) => {
  res.json({ ok: true, message: 'API do sistema de restaurante funcionando.' });
});

app.get('*', (req, res) => {
  const filePath = path.join(__dirname, req.path);
  if (fs.existsSync(filePath) && fs.statSync(filePath).isFile()) {
    return res.sendFile(filePath);
  }

  if (req.path === '/' || !req.path.includes('.')) {
    return res.sendFile(path.join(__dirname, 'index.html'));
  }

  res.status(404).send('Página não encontrada');
});

app.listen(port, () => {
  console.log(`Servidor rodando em http://localhost:${port}`);
});
